    <!-- =================================================
         SEARCH & FILTER
    ================================================== -->

    <section class="filter-card">


        <div class="search-box">

            <span>
                🔍
            </span>

            <input
                type="text"
                id="studentSearch"
                placeholder="Search by name, student ID or roll number..."
