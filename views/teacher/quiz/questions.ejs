            Profile

        </a>

    </nav>



    <!-- LOGOUT -->

    <div class="sidebar-bottom">

        <a
            href="/logout"
            class="logout-btn"
        >

            <span>
                🚪
            </span>

            Logout

        </a>

    </div>

</aside>



<!-- =====================================================
     MAIN
===================================================== -->

<main class="main-content">


    <!-- TOPBAR -->

    <header class="topbar">


        <div class="page-title">

            <span>
                TEACHER PORTAL
            </span>

            <h1>
                Quiz Questions
            </h1>

        </div>


        <a
            href="/teacher/quiz"
            class="back-btn"
        >
            ← Back to Quizzes
        </a>

    </header>



    <div class="question-container">


        <!-- =================================================
             QUIZ INFORMATION
        ================================================= -->

        <section class="quiz-info-card">


            <div class="quiz-info-left">


                <div class="quiz-main-icon">
                    📚
                </div>


                <div>

                    <span>
                        SUBJECT WISE QUIZ
                    </span>

                    <h2>
                        Data Structures - Unit 1
                    </h2>

                    <p>
                        Semester 4 • Medium • 30 Minutes
                    </p>

                </div>


            </div>



            <div class="quiz-stat-box">


                <div class="quiz-stat">

                    <strong>
                        8
                    </strong>

                    <span>
                        Questions
                    </span>

                </div>


                <div class="quiz-stat">

                    <strong>
                        8
                    </strong>

                    <span>
                        Marks
                    </span>

                </div>


                <div class="quiz-stat">

                    <strong>
                        30
                    </strong>

                    <span>
                        Minutes
                    </span>

                </div>


            </div>


        </section>



        <!-- =================================================
             ADD QUESTION
        ================================================= -->

        <section class="add-question-card">


            <div class="question-heading">


                <div>

                    <span>
                        QUESTION BUILDER
                    </span>

                    <h2>
                        Add New Question
                    </h2>

                </div>


                <span>
                    MCQ
                </span>


            </div>



            <form
                action="/teacher/quiz/1/questions"
                method="POST"
            >


                <!-- QUESTION -->

                <div class="question-form-group">

                    <label>
                        Question *
                    </label>

                    <textarea
                        name="question"
                        placeholder="Write your question here..."
                        required
                    ></textarea>

                </div>



                <!-- OPTIONS -->

                <h3 class="options-title">
                    Answer Options
                </h3>


                <div class="options-grid">


                    <!-- A -->

                    <div class="option-box">

                        <span class="option-label">
                            A
                        </span>

                        <input
                            type="text"
                            name="optionA"
                            placeholder="Option A"
                            required
                        >

                    </div>



                    <!-- B -->

                    <div class="option-box">

                        <span class="option-label">
                            B
                        </span>

                        <input
                            type="text"
                            name="optionB"
                            placeholder="Option B"
                            required
                        >

                    </div>



                    <!-- C -->

                    <div class="option-box">

                        <span class="option-label">
                            C
                        </span>

                        <input
                            type="text"
                            name="optionC"
                            placeholder="Option C"
                            required
                        >

                    </div>



                    <!-- D -->

                    <div class="option-box">

                        <span class="option-label">
                            D
                        </span>

                        <input
                            type="text"
                            name="optionD"
                            placeholder="Option D"
                            required
                        >

                    </div>


                </div>



                <!-- ANSWER + MARKS -->

                <div class="answer-section">


                    <div class="question-form-group">

                        <label>
                            Correct Answer *
                        </label>

                        <select
                            name="correctAnswer"
                            required
                        >

                            <option value="">
                                Select Correct Answer
                            </option>

                            <option value="A">
                                Option A
                            </option>

                            <option value="B">
                                Option B
                            </option>

                            <option value="C">
                                Option C
                            </option>

                            <option value="D">
                                Option D
                            </option>

                        </select>

                    </div>


                    <div class="question-form-group">

                        <label>
                            Marks
                        </label>

                        <input
                            type="number"
                            name="marks"
                            value="1"
                            min="1"
                            max="100"
                        >

                    </div>


                </div>



                <!-- BUTTONS -->

                <div class="question-actions">


                    <button
                        type="reset"
                        class="reset-btn"
                    >
                        Clear
                    </button>


                    <button
                        type="submit"
                        class="add-question-btn"
                    >
                        + Add Question
                    </button>


                </div>


            </form>


        </section>



        <!-- =================================================
             QUESTIONS LIST
        ================================================= -->

        <section class="questions-list-card">


            <div class="questions-list-header">


                <div>

                    <span>
                        QUIZ QUESTIONS
                    </span>

                    <h2>
                        Added Questions
                    </h2>

                </div>


                <span class="question-count">
                    8 Questions • 8 Marks
                </span>


            </div>



            <!-- QUESTION 1 -->

            <div class="question-item">


                <div class="question-top">


                    <div class="question-number">
                        01
                    </div>


                    <div class="question-content">

                        <h3>
                            Which data structure follows the
                            LIFO principle?
                        </h3>

                        <p>
                            Data Structures
                        </p>

                    </div>


                </div>



                <div class="saved-options">

                    <div class="saved-option correct">
                        A. Stack ✓
                    </div>

                    <div class="saved-option">
                        B. Queue
                    </div>

                    <div class="saved-option">
                        C. Linked List
                    </div>

                    <div class="saved-option">
                        D. Array
                    </div>

                </div>



                <div class="question-footer">

                    <span class="question-marks">
                        Marks:
                        <strong>
                            1
                        </strong>
                    </span>


                    <div class="saved-actions">

                        <button
                            type="button"
                            title="Edit"
                        >
                            ✏️
                        </button>

                        <button
                            type="button"
                            title="Delete"
                        >
                            🗑️
                        </button>

                    </div>

                </div>


            </div>



            <!-- QUESTION 2 -->

            <div class="question-item">


                <div class="question-top">


                    <div class="question-number">
                        02
                    </div>


                    <div class="question-content">

                        <h3>
                            What is the time complexity of
                            binary search?
                        </h3>

                        <p>
                            Algorithms
                        </p>

                    </div>


                </div>



                <div class="saved-options">

                    <div class="saved-option">
                        A. O(n)
                    </div>

                    <div class="saved-option correct">
                        B. O(log n) ✓
                    </div>

                    <div class="saved-option">
                        C. O(n²)
                    </div>

                    <div class="saved-option">
                        D. O(1)
                    </div>

                </div>



                <div class="question-footer">

                    <span class="question-marks">
                        Marks:
                        <strong>
                            1
                        </strong>
                    </span>


                    <div class="saved-actions">

                        <button
                            type="button"
                        >
                            ✏️
                        </button>

                        <button
                            type="button"
                        >
                            🗑️
                        </button>

                    </div>

                </div>


            </div>



            <!-- QUESTION 3 -->

            <div class="question-item">


                <div class="question-top">


                    <div class="question-number">
                        03
                    </div>


                    <div class="question-content">

                        <h3>
                            Which data structure is used for
                            BFS traversal?
                        </h3>

                        <p>
                            Graph Algorithms
                        </p>

                    </div>


                </div>



                <div class="saved-options">

                    <div class="saved-option">
                        A. Stack
                    </div>

                    <div class="saved-option correct">
                        B. Queue ✓
                    </div>

                    <div class="saved-option">
                        C. Heap
                    </div>

                    <div class="saved-option">
                        D. Tree
                    </div>

                </div>



                <div class="question-footer">

                    <span class="question-marks">
                        Marks:
                        <strong>
                            1
                        </strong>
                    </span>


                    <div class="saved-actions">

                        <button
                            type="button"
                        >
                            ✏️
                        </button>

                        <button
                            type="button"
                        >
                            🗑️
                        </button>

                    </div>

                </div>


            </div>



            <!-- =================================================
                 PUBLISH
            ================================================= -->

            <div class="publish-section">


                <div class="publish-info">

                    <strong>
                        Ready to publish?
                    </strong>

                    <span>
                        Make sure all questions and answers
                        are correct before publishing.
                    </span>

                </div>


                <form
                    action="/teacher/quiz/1/publish"
                    method="POST"
                >

                    <button
                        type="submit"
                        class="publish-btn"
                    >
                        🚀 Publish Quiz
                    </button>

                </form>


            </div>


        </section>


    </div>


</main>


</body>

</html>