<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Create Quiz | Teacher | SmartEdu</title>

    <link
        rel="stylesheet"
        href="/css/teacher-quiz.css"
    >

    <style>

        .create-container {
            max-width: 950px;
            margin: 0 auto;
        }

        .create-card {
            background: white;
            border-radius: 15px;
            padding: 28px;
            box-shadow: 0 4px 18px rgba(0,0,0,.04);
        }

        .create-heading {
            padding-bottom: 20px;
            margin-bottom: 25px;
            border-bottom: 1px solid #edf0f4;
        }

        .create-heading span {
            color: #6366f1;
            font-size: 8px;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .create-heading h2 {
            font-size: 21px;
            margin-top: 7px;
        }

        .create-heading p {
            color: #8994a7;
            font-size: 9px;
            margin-top: 6px;
        }

        .form-section {
            margin-bottom: 28px;
        }

        .form-section-title {
            font-size: 13px;
            margin-bottom: 15px;
            padding-bottom: 9px;
            border-bottom: 1px solid #f0f1f4;
        }

        .form-group {
            margin-bottom: 17px;
        }

        .form-group label {
            display: block;
            color: #354052;
            font-size: 9px;
            font-weight: 600;
            margin-bottom: 7px;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            border: 1px solid #dfe3eb;
            border-radius: 8px;
            padding: 11px;
            outline: none;
            background: white;
            color: #374151;
            font-size: 10px;
        }

        .form-group input,
        .form-group select {
            height: 40px;
        }

        .form-group textarea {
            min-height: 90px;
            resize: vertical;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99,102,241,.08);
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .form-grid-4 {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        /* CATEGORY */

        .category-options {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
        }

        .category-option {
            position: relative;
            cursor: pointer;
        }

        .category-option input {
            display: none;
        }

        .category-content {
            border: 1px solid #dfe3eb;
            border-radius: 10px;
            padding: 17px;
            transition: .2s;
        }

        .category-option input:checked
        + .category-content {
            border-color: #6366f1;
            background: #f5f5ff;
        }

        .category-content .icon {
            font-size: 22px;
            margin-bottom: 9px;
        }

        .category-content strong {
            display: block;
            font-size: 10px;
        }

        .category-content span {
            display: block;
            color: #8994a7;
            font-size: 8px;
            line-height: 1.4;
            margin-top: 5px;
        }

        /* INSTRUCTIONS */

        .instruction-box {
            background: #f8f9fc;
            border-radius: 9px;
            padding: 15px;
            margin-top: 8px;
        }

        .instruction-box ul {
            padding-left: 18px;
        }

        .instruction-box li {
            color: #8994a7;
            font-size: 8px;
            margin-bottom: 6px;
        }

        /* BUTTONS */

        .create-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding-top: 20px;
            border-top: 1px solid #edf0f4;
        }

        .cancel-btn {
            height: 40px;
            padding: 0 18px;
            border: 1px solid #dfe3eb;
            border-radius: 8px;
            background: white;
            color: #596579;
            font-size: 9px;
            cursor: pointer;
            display: flex;
            align-items: center;
        }

        .cancel-btn:hover {
            background: #f8f9fc;
        }

        .create-submit-btn {
            height: 40px;
            padding: 0 20px;
            border: none;
            border-radius: 8px;
            background: #4f46e5;
            color: white;
            font-size: 9px;
            font-weight: bold;
            cursor: pointer;
        }

        .create-submit-btn:hover {
            background: #4338ca;
        }

        /* HIDDEN SUBJECT */

        #subjectSection {
            display: block;
        }

        @media (max-width: 800px) {

            .category-options {
                grid-template-columns: 1fr;
            }

            .form-grid-4 {
                grid-template-columns: repeat(2, 1fr);
            }

        }

        @media (max-width: 600px) {

            .create-card {
                padding: 20px 15px;
            }

            .form-grid,
            .form-grid-4 {
                grid-template-columns: 1fr;
            }

            .create-actions {
                flex-direction: column;
            }

            .cancel-btn,
            .create-submit-btn {
                width: 100%;
                justify-content: center;
            }

        }

    </style>

</head>


<body>


<!-- =====================================================
     SIDEBAR
===================================================== -->

<aside class="sidebar">


    <div class="brand">

        <div class="brand-logo">
            🎓
        </div>

        <div class="brand-text">

            <h2>SmartEdu</h2>

            <span>Teacher Portal</span>

        </div>

    </div>



    <div class="teacher-mini-profile">

        <div class="teacher-avatar">
            T
        </div>

        <div class="teacher-mini-info">

            <strong>
                Teacher Name
            </strong>

            <span>
                ID: EMP001
            </span>

        </div>

    </div>



    <nav class="sidebar-nav">


        <p class="nav-title">
            MAIN MENU
        </p>


        <a
            href="/teacher/dashboard"
            class="nav-item"
        >

            <span class="nav-icon">
                📊
            </span>

            Dashboard

        </a>


        <a
            href="/teacher/students"
            class="nav-item"
        >

            <span class="nav-icon">
                👨‍🎓
            </span>

            Students

        </a>


        <a
            href="/teacher/attendance"
            class="nav-item"
        >

            <span class="nav-icon">
                📅
            </span>

            Attendance

        </a>


        <a
            href="/teacher/syllabus"
            class="nav-item"
        >

            <span class="nav-icon">
                📚
            </span>

            Syllabus

        </a>


        <a
            href="/teacher/resources"
            class="nav-item"
        >

            <span class="nav-icon">
                📖
            </span>

            Resources

        </a>


        <a
            href="/teacher/quiz"
            class="nav-item active"
        >

            <span class="nav-icon">
                📝
            </span>

            Quiz

        </a>


        <p class="nav-title secondary-title">
            ACCOUNT
        </p>


        <a
            href="/teacher/profile"
            class="nav-item"
        >

            <span class="nav-icon">
                👤
            </span>

            Profile

        </a>

    </nav>



    <div class="sidebar-bottom">

        <a
            href="/logout"
            class="logout-btn"
        >

            <span>
                🚪
            </span>

            Logout

        </a>

    </div>

</aside>



<!-- =====================================================
     MAIN
===================================================== -->

<main class="main-content">


    <header class="topbar">


        <div class="page-title">

            <span>
                TEACHER PORTAL
            </span>

            <h1>
                Create Quiz
            </h1>

        </div>


        <a
            href="/teacher/quiz"
            class="back-btn"
        >
            ← Back to Quizzes
        </a>

    </header>



    <!-- =====================================================
         CREATE FORM
    ===================================================== -->

    <div class="create-container">


        <section class="create-card">


            <div class="create-heading">

                <span>
                    QUIZ MANAGEMENT
                </span>

                <h2>
                    Create a New Quiz
                </h2>

                <p>
                    Configure your quiz before adding questions.
                </p>

            </div>



            <form
                action="/teacher/quiz/create"
                method="POST"
            >


                <!-- =================================================
                     BASIC INFORMATION
                ================================================= -->

                <div class="form-section">


                    <h3 class="form-section-title">
                        1. Basic Information
                    </h3>


                    <div class="form-group">

                        <label>
                            Quiz Title *
                        </label>

                        <input
                            type="text"
                            name="title"
                            placeholder="Example: Data Structures Unit 1 Quiz"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            Description
                        </label>

                        <textarea
                            name="description"
                            placeholder="Describe what students will learn or practice..."
                        ></textarea>

                    </div>


                </div>



                <!-- =================================================
                     CATEGORY
                ================================================= -->

                <div class="form-section">


                    <h3 class="form-section-title">
                        2. Quiz Category
                    </h3>


                    <div class="category-options">


                        <!-- SUBJECT -->

                        <label class="category-option">

                            <input
                                type="radio"
                                name="category"
                                value="subject"
                                checked
                                onchange="categoryChanged('subject')"
                            >

                            <div class="category-content">

                                <div class="icon">
                                    📚
                                </div>

                                <strong>
                                    Subject Wise
                                </strong>

                                <span>
                                    Quiz based on academic
                                    subjects and syllabus.
                                </span>

                            </div>

                        </label>



                        <!-- DSA -->

                        <label class="category-option">

                            <input
                                type="radio"
                                name="category"
                                value="dsa"
                                onchange="categoryChanged('dsa')"
                            >

                            <div class="category-content">

                                <div class="icon">
                                    💻
                                </div>

                                <strong>
                                    DSA
                                </strong>

                                <span>
                                    Data Structures and
                                    Algorithms practice.
                                </span>

                            </div>

                        </label>



                        <!-- APTITUDE -->

                        <label class="category-option">

                            <input
                                type="radio"
                                name="category"
                                value="aptitude"
                                onchange="categoryChanged('aptitude')"
                            >

                            <div class="category-content">

                                <div class="icon">
                                    🧠
                                </div>

                                <strong>
                                    Aptitude
                                </strong>

                                <span>
                                    Quantitative, logical and
                                    verbal aptitude.
                                </span>

                            </div>

                        </label>


                    </div>

                </div>



                <!-- =================================================
                     ACADEMIC INFORMATION
                ================================================= -->

                <div
                    class="form-section"
                    id="academicSection"
                >


                    <h3 class="form-section-title">
                        3. Academic Information
                    </h3>


                    <div class="form-grid">


                        <!-- SEMESTER -->

                        <div class="form-group">

                            <label>
                                Semester *
                            </label>

                            <select
                                name="semester"
                                required
                            >

                                <option value="">
                                    Select Semester
                                </option>

                                <option value="1">
                                    Semester 1
                                </option>

                                <option value="2">
                                    Semester 2
                                </option>

                                <option value="3">
                                    Semester 3
                                </option>

                                <option value="4">
                                    Semester 4
                                </option>

                                <option value="5">
                                    Semester 5
                                </option>

                                <option value="6">
                                    Semester 6
                                </option>

                                <option value="7">
                                    Semester 7
                                </option>

                                <option value="8">
                                    Semester 8
                                </option>

                            </select>

                        </div>



                        <!-- SUBJECT -->

                        <div
                            class="form-group"
                            id="subjectSection"
                        >

                            <label>
                                Subject *
                            </label>

                            <select name="subject">

                                <option value="">
                                    Select Subject
                                </option>

                                <option>
                                    Data Structures & Algorithms
                                </option>

                                <option>
                                    Database Management System
                                </option>

                                <option>
                                    Operating Systems
                                </option>

                                <option>
                                    Computer Networks
                                </option>

                                <option>
                                    Computer Architecture
                                </option>

                            </select>

                        </div>


                    </div>


                    <!-- TOPIC -->

                    <div
                        class="form-group"
                        id="topicSection"
                    >

                        <label>
                            Topic / Unit
                        </label>

                        <input
                            type="text"
                            name="topic"
                            placeholder="Example: Unit 2 - Linked Lists"
                        >

                    </div>


                </div>



                <!-- =================================================
                     QUIZ SETTINGS
                ================================================= -->

                <div class="form-section">


                    <h3 class="form-section-title">
                        4. Quiz Settings
                    </h3>


                    <div class="form-grid-4">


                        <!-- DIFFICULTY -->

                        <div class="form-group">

                            <label>
                                Difficulty
                            </label>

                            <select name="difficulty">

                                <option value="easy">
                                    Easy
                                </option>

                                <option
                                    value="medium"
                                    selected
                                >
                                    Medium
                                </option>

                                <option value="hard">
                                    Hard
                                </option>

                            </select>

                        </div>



                        <!-- DURATION -->

                        <div class="form-group">

                            <label>
                                Duration
                            </label>

                            <select name="duration">

                                <option value="10">
                                    10 Minutes
                                </option>

                                <option value="15">
                                    15 Minutes
                                </option>

                                <option value="20">
                                    20 Minutes
                                </option>

                                <option
                                    value="30"
                                    selected
                                >
                                    30 Minutes
                                </option>

                                <option value="45">
                                    45 Minutes
                                </option>

                                <option value="60">
                                    60 Minutes
                                </option>

                                <option value="90">
                                    90 Minutes
                                </option>

                            </select>

                        </div>



                        <!-- TOTAL MARKS -->

                        <div class="form-group">

                            <label>
                                Total Marks
                            </label>

                            <input
                                type="number"
                                name="totalMarks"
                                value="20"
                                min="1"
                            >

                        </div>



                        <!-- PASSING -->

                        <div class="form-group">

                            <label>
                                Passing Marks
                            </label>

                            <input
                                type="number"
                                name="passingMarks"
                                value="8"
                                min="1"
                            >

                        </div>


                    </div>

                </div>



                <!-- =================================================
                     INSTRUCTIONS
                ================================================= -->

                <div class="form-section">


                    <h3 class="form-section-title">
                        5. Student Instructions
                    </h3>


                    <div class="form-group">

                        <label>
                            Instructions
                        </label>

                        <textarea
                            name="instructions"
                            placeholder="Write instructions for students..."
                        ></textarea>


                        <div class="instruction-box">

                            <ul>

                                <li>
                                    Read each question carefully.
                                </li>

                                <li>
                                    Each question has only one correct answer.
                                </li>

                                <li>
                                    Do not refresh the page during the quiz.
                                </li>

                                <li>
                                    Submit the quiz before the timer ends.
                                </li>

                            </ul>

                        </div>

                    </div>


                </div>



                <!-- =================================================
                     ACTIONS
                ================================================= -->

                <div class="create-actions">


                    <a
                        href="/teacher/quiz"
                        class="cancel-btn"
                    >
                        Cancel
                    </a>


                    <button
                        type="submit"
                        class="create-submit-btn"
                    >
                        Create Quiz & Continue →
                    </button>


                </div>


            </form>


        </section>


    </div>


</main>



<script>

function categoryChanged(category) {

    const subjectSection =
        document.getElementById(
            "subjectSection"
        );

    const topicSection =
        document.getElementById(
            "topicSection"
        );


    if (category === "subject") {

        subjectSection.style.display =
            "block";

        topicSection.style.display =
            "block";

    }


    else if (category === "dsa") {

        subjectSection.style.display =
            "none";

        topicSection.style.display =
            "block";

    }


    else if (category === "aptitude") {

        subjectSection.style.display =
            "none";

        topicSection.style.display =
            "block";

    }

}

</script>


</body>

</html>