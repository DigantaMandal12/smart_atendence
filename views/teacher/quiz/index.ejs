<script>

const categoryFilter =
    document.getElementById("categoryFilter");

const statusFilter =
    document.getElementById("statusFilter");

const searchInput =
    document.getElementById("quizSearch");

const quizItems =
    document.querySelectorAll(".quiz-item");


function filterQuizzes() {

    const category =
        categoryFilter.value;

    const status =
        statusFilter.value;

    const search =
        searchInput.value.toLowerCase();


    quizItems.forEach(function (quiz) {

        const quizCategory =
            quiz.dataset.category;

        const quizStatus =
            quiz.dataset.status;

        const title =
            quiz
                .querySelector("h3")
                .textContent
                .toLowerCase();


        const categoryMatch =
            category === "all" ||
            quizCategory === category;


        const statusMatch =
            status === "all" ||
            quizStatus === status;


        const searchMatch =
            title.includes(search);


        if (
            categoryMatch &&
            statusMatch &&
            searchMatch
        ) {

            quiz.style.display = "flex";

        } else {

            quiz.style.display = "none";

        }

    });

}


categoryFilter.addEventListener(
    "change",
    filterQuizzes
);

statusFilter.addEventListener(
    "change",
    filterQuizzes
);

searchInput.addEventListener(
    "input",
    filterQuizzes
);

</script>


