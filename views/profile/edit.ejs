```html
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Edit Profile | Smart Academic System</title>

    <link
        rel="stylesheet"
        href="/css/dashboard.css"
    >

    <link
        rel="stylesheet"
        href="/css/profile.css"
    >

</head>

<body>


    <!-- ================= SIDEBAR ================= -->

    <aside class="sidebar">

        <div class="logo">

            <div class="logo-icon">
                🎓
            </div>

            <div>

                <h2>SmartEdu</h2>

                <span>
                    Academic System
                </span>

            </div>

        </div>


        <nav class="navigation">

            <a
                href="/dashboard"
                class="nav-item"
            >
                <span>📊</span>
                Dashboard
            </a>


            <a
                href="/attendance"
                class="nav-item"
            >
                <span>📅</span>
                Attendance
            </a>


            <a
                href="/syllabus"
                class="nav-item"
            >
                <span>📚</span>
                Syllabus
            </a>


            <a
                href="/resources"
                class="nav-item"
            >
                <span>📖</span>
                Resources
            </a>


            <a
                href="/quiz"
                class="nav-item"
            >
                <span>📝</span>
                Quiz
            </a>


            <a
                href="/profile"
                class="nav-item active"
            >
                <span>👤</span>
                Profile
            </a>

        </nav>


        <div class="sidebar-bottom">

            <a
                href="/logout"
                class="nav-item logout"
            >
                <span>🚪</span>
                Logout
            </a>

        </div>

    </aside>


    <!-- ================= MAIN ================= -->

    <main class="main-content">


        <!-- HEADER -->

        <header class="topbar">

            <div class="page-title">

                <button
                    class="menu-btn"
                    id="menuBtn"
                >
                    ☰
                </button>


                <div>

                    <h1>
                        Edit Profile
                    </h1>

                    <p>
                        Update your personal information
                    </p>

                </div>

            </div>

        </header>


        <!-- ================= EDIT FORM ================= -->

        <section class="edit-card">


            <div class="edit-heading">

                <div class="profile-avatar edit-avatar">
                    S
                </div>

                <div>

                    <h2>
                        Personal Information
                    </h2>

                    <p>
                        Update the information below
                    </p>

                </div>

            </div>


            <form
                action="/profile/edit"
                method="POST"
                id="profileForm"
            >


                <!-- ================= PERSONAL ================= -->

                <div class="form-section">

                    <h3>
                        Personal Details
                    </h3>


                    <div class="form-grid">


                        <div class="form-group">

                            <label for="name">
                                Full Name
                            </label>

                            <input
                                type="text"
                                id="name"
                                name="name"
                                value="Student Name"
                                required
                            >

                        </div>


                        <div class="form-group">

                            <label for="email">
                                Email Address
                            </label>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                value="student@example.com"
                                required
                            >

                        </div>


                        <div class="form-group">

                            <label for="phone">
                                Phone Number
                            </label>

                            <input
                                type="tel"
                                id="phone"
                                name="phone"
                                value=""
                                placeholder="+91 XXXXX XXXXX"
                            >

                        </div>


                        <div class="form-group">

                            <label for="dob">
                                Date of Birth
                            </label>

                            <input
                                type="date"
                                id="dob"
                                name="dob"
                            >

                        </div>


                        <div class="form-group">

                            <label for="gender">
                                Gender
                            </label>

                            <select
                                id="gender"
                                name="gender"
                            >

                                <option value="">
                                    Select Gender
                                </option>

                                <option value="male">
                                    Male
                                </option>

                                <option value="female">
                                    Female
                                </option>

                                <option value="other">
                                    Other
                                </option>

                                <option value="prefer-not">
                                    Prefer not to say
                                </option>

                            </select>

                        </div>


                        <div class="form-group full">

                            <label for="address">
                                Address
                            </label>

                            <textarea
                                id="address"
                                name="address"
                                rows="3"
                                placeholder="Enter your address"
                            ></textarea>

                        </div>

                    </div>

                </div>


                <!-- ================= ACADEMIC ================= -->

                <div class="form-section">

                    <h3>
                        Academic Information
                    </h3>


                    <div class="form-grid">


                        <div class="form-group">

                            <label>
                                Student ID
                            </label>

                            <input
                                type="text"
                                value="STU001"
                                disabled
                            >

                            <small>
                                Student ID cannot be changed.
                            </small>

                        </div>


                        <div class="form-group">

                            <label>
                                Roll Number
                            </label>

                            <input
                                type="text"
                                value="CSE2026001"
                                disabled
                            >

                            <small>
                                Contact administration to change this.
                            </small>

                        </div>


                        <div class="form-group">

                            <label>
                                Department
                            </label>

                            <input
                                type="text"
                                value="Computer Science & Engineering"
                                disabled
                            >

                        </div>


                        <div class="form-group">

                            <label>
                                Course
                            </label>

                            <input
                                type="text"
                                value="B.Tech"
                                disabled
                            >

                        </div>


                        <div class="form-group">

                            <label>
                                Semester
                            </label>

                            <input
                                type="text"
                                value="Semester 4"
                                disabled
                            >

                        </div>


                        <div class="form-group">

                            <label>
                                Section
                            </label>

                            <input
                                type="text"
                                value="A"
                                disabled
                            >

                        </div>

                    </div>

                </div>


                <!-- ================= BUTTONS ================= -->

                <div class="form-actions">

                    <a
                        href="/profile"
                        class="cancel-btn"
                    >
                        Cancel
                    </a>


                    <button
                        type="submit"
                        class="save-btn"
                    >
                        💾 Save Changes
                    </button>

                </div>

            </form>

        </section>

    </main>


    <script src="/js/profile.js"></script>

</body>

</html>
```
