<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Sign Up | Smart Academic System</title>

    <link
        rel="stylesheet"
        href="/css/signup.css"
    >

    <style>

        .role-page {
            min-height: 100vh;

            display: flex;

            align-items: center;

            justify-content: center;

            background: #f8fafc;

            padding: 30px;
        }

        .role-container {
            width: 100%;
            max-width: 900px;

            background: white;

            border-radius: 20px;

            padding: 45px;

            box-shadow:
                0 15px 40px rgba(0,0,0,0.08);

            text-align: center;
        }

        .role-icon {
            width: 70px;
            height: 70px;

            margin: 0 auto 18px;

            background: #4f46e5;

            border-radius: 18px;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 34px;
        }

        .role-container h1 {
            font-size: 30px;

            margin-bottom: 8px;

            color: #111827;
        }

        .role-container > p {
            color: #6b7280;

            font-size: 13px;

            margin-bottom: 35px;
        }

        .role-cards {
            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 20px;
        }

        .role-card {
            border: 1px solid #e5e7eb;

            border-radius: 15px;

            padding: 30px 25px;

            text-decoration: none;

            color: #111827;

            transition: 0.25s;
        }

        .role-card:hover {
            border-color: #4f46e5;

            transform: translateY(-5px);

            box-shadow:
                0 10px 25px rgba(79,70,229,0.12);
        }

        .role-card-icon {
            width: 60px;
            height: 60px;

            margin: 0 auto 15px;

            border-radius: 15px;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 28px;
        }

        .student-icon {
            background: #eef2ff;
        }

        .teacher-icon {
            background: #ecfeff;
        }

        .role-card h2 {
            font-size: 18px;

            margin-bottom: 8px;
        }

        .role-card p {
            color: #6b7280;

            font-size: 11px;

            line-height: 1.6;

            margin-bottom: 20px;
        }

        .role-button {
            display: inline-block;

            padding: 10px 18px;

            background: #4f46e5;

            color: white;

            border-radius: 8px;

            font-size: 10px;

            font-weight: 600;
        }

        .login-link {
            margin-top: 25px;

            font-size: 10px;

            color: #9ca3af;
        }

        .login-link a {
            color: #4f46e5;

            text-decoration: none;

            font-weight: 600;
        }

        @media (max-width: 650px) {

            .role-cards {
                grid-template-columns: 1fr;
            }

            .role-container {
                padding: 30px 20px;
            }

        }

    </style>

</head>


<body>

    <div class="role-page">

        <div class="role-container">


            <div class="role-icon">
                🎓
            </div>


            <h1>
                Create Your Account
            </h1>


            <p>
                Choose your account type to get started
                with Smart Academic System.
            </p>


            <div class="role-cards">


                <!-- ========================= -->
                <!-- STUDENT -->
                <!-- ========================= -->

                <a
                    href="/signup/student"
                    class="role-card"
                >

                    <div
                        class="role-card-icon student-icon"
                    >
                        👨‍🎓
                    </div>


                    <h2>
                        Student
                    </h2>


                    <p>
                        Create a student account to access
                        attendance, syllabus, resources,
                        quizzes and academic progress.
                    </p>


                    <span class="role-button">
                        Register as Student →
                    </span>

                </a>


                <!-- ========================= -->
                <!-- TEACHER -->
                <!-- ========================= -->

                <a
                    href="/signup/teacher"
                    class="role-card"
                >

                    <div
                        class="role-card-icon teacher-icon"
                    >
                        👨‍🏫
                    </div>


                    <h2>
                        Teacher
                    </h2>


                    <p>
                        Create a teacher account to manage
                        students, attendance, syllabus,
                        resources and quizzes.
                    </p>


                    <span class="role-button">
                        Register as Teacher →
                    </span>

                </a>

            </div>


            <div class="login-link">

                Already have an account?

                <a href="/login">
                    Login
                </a>

            </div>


        </div>

    </div>

</body>

</html>