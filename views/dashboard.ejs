                    </div>

                </div>

                <div class="class-list">

                    <div class="class-item">

                        <div class="class-time">
                            <strong>09:00</strong>
                            <span>10:00 AM</span>
                        </div>

                        <div class="class-info">
                            <strong>Data Structures</strong>
                            <span>Room 204 • Prof. Sharma</span>
                        </div>

                        <span class="class-status ongoing">
                            Completed
                        </span>

                    </div>


                    <div class="class-item">

                        <div class="class-time">
                            <strong>11:00</strong>
                            <span>12:00 PM</span>
                        </div>

                        <div class="class-info">
                            <strong>Database Management</strong>
                            <span>Room 302 • Prof. Roy</span>
                        </div>

                        <span class="class-status next">
                            Next
                        </span>

                    </div>


                    <div class="class-item">

                        <div class="class-time">
                            <strong>02:00</strong>
                            <span>03:00 PM</span>
                        </div>

                        <div class="class-info">
                            <strong>Web Development</strong>
                            <span>Lab 1 • Prof. Das</span>
                        </div>

                        <span class="class-status upcoming">
                            Upcoming
                        </span>

                    </div>

                </div>

            </div>


            <!-- Syllabus -->

            <div class="dashboard-card">

                <div class="card-header">

                    <div>
                        <h3>Syllabus Progress</h3>
                        <p>Current semester</p>
                    </div>

                    <a href="/syllabus">
                        View All →
                    </a>

                </div>


                <div class="progress-list">

                    <div class="progress-item">

                        <div class="progress-title">
                            <span>Data Structures</span>
                            <strong>90%</strong>
                        </div>

                        <div class="progress-bar">
                            <div style="width: 90%"></div>
                        </div>

                    </div>


                    <div class="progress-item">

                        <div class="progress-title">
                            <span>Database Management</span>
                            <strong>75%</strong>
                        </div>

                        <div class="progress-bar">
                            <div style="width: 75%"></div>
                        </div>

                    </div>


                    <div class="progress-item">

                        <div class="progress-title">
                            <span>Web Development</span>
                            <strong>65%</strong>
                        </div>

                        <div class="progress-bar">
                            <div style="width: 65%"></div>
                        </div>

                    </div>


                    <div class="progress-item">

                        <div class="progress-title">
                            <span>Computer Networks</span>
                            <strong>58%</strong>
                        </div>

                        <div class="progress-bar">
                            <div style="width: 58%"></div>
                        </div>

                    </div>

                </div>

            </div>


            <!-- Recent Quizzes -->

            <div class="dashboard-card">

                <div class="card-header">

                    <div>
                        <h3>Recent Quizzes</h3>
                        <p>Your latest performance</p>
                    </div>

                    <a href="/quiz">
                        Take Quiz →
                    </a>

                </div>


                <div class="quiz-list">

                    <div class="quiz-item">

                        <div class="quiz-icon">
                            📝
                        </div>

                        <div class="quiz-info">
                            <strong>JavaScript Basics</strong>
                            <span>10 Questions</span>
                        </div>

                        <div class="quiz-score">
                            <strong>9/10</strong>
                            <span>90%</span>
                        </div>

                    </div>


                    <div class="quiz-item">

                        <div class="quiz-icon">
                            📝
                        </div>

                        <div class="quiz-info">
                            <strong>MongoDB Fundamentals</strong>
                            <span>10 Questions</span>
                        </div>

                        <div class="quiz-score">
                            <strong>8/10</strong>
                            <span>80%</span>
                        </div>

                    </div>


                    <div class="quiz-item">

                        <div class="quiz-icon">
                            📝
                        </div>

                        <div class="quiz-info">
                            <strong>HTML & CSS</strong>
                            <span>10 Questions</span>
                        </div>

                        <div class="quiz-score">
                            <strong>8/10</strong>
                            <span>80%</span>
                        </div>

                    </div>

                </div>

            </div>


        </section>


        <!-- Quick Actions -->

        <section class="quick-actions">

            <h3>Quick Actions</h3>

            <div class="action-grid">

                <a href="/attendance" class="action-card">
                    <span>📅</span>
                    <strong>Mark Attendance</strong>
                    <small>Scan classroom QR</small>
                </a>

                <a href="/syllabus" class="action-card">
                    <span>📚</span>
                    <strong>View Syllabus</strong>
                    <small>Track your progress</small>
                </a>

                <a href="/resources" class="action-card">
                    <span>📖</span>
                    <strong>Study Resources</strong>
                    <small>Notes & materials</small>
                </a>

                <a href="/quiz" class="action-card">
                    <span>📝</span>
                    <strong>Take a Quiz</strong>
                    <small>Test your knowledge</small>
                </a>

            </div>

        </section>

    </main>


    <script src="/js/dashboard.js"></script>

</body>
</html>

