<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard | Smart Academic System</title>

    <link rel="stylesheet" href="/css/dashboard.css">
</head>

<body>

    <!-- Sidebar -->

    <aside class="sidebar">

        <div class="logo">
            <div class="logo-icon">🎓</div>
            <div>
                <h2>SmartEdu</h2>
                <span>Academic System</span>
            </div>
        </div>

        <nav class="navigation">

            <a href="/dashboard" class="nav-item active">
                <span>📊</span>
                Dashboard
            </a>

            <a href="/attendance" class="nav-item">
                <span>📅</span>
                Attendance
            </a>

            <a href="/syllabus" class="nav-item">
                <span>📚</span>
                Syllabus
            </a>

            <a href="/resources" class="nav-item">
                <span>📖</span>
                Resources
            </a>

            <a href="/quiz" class="nav-item">
                <span>📝</span>
                Quiz
            </a>

            <a href="/profile" class="nav-item">
                <span>👤</span>
                Profile
            </a>

        </nav>

        <div class="sidebar-bottom">

            <a href="/logout" class="nav-item logout">
                <span>🚪</span>
                Logout
            </a>

        </div>

    </aside>


    <!-- Main Content -->

    <main class="main-content">

        <!-- Header -->

        <header class="topbar">

            <div>
                <button class="menu-btn" id="menuBtn">☰</button>

                <h1>Dashboard</h1>

                <p>
                    Welcome back, Student 👋
                </p>
            </div>

            <div class="topbar-right">

                <button class="notification-btn">
                    🔔
                    <span class="notification-dot"></span>
                </button>

                <div class="profile-mini">

                    <div class="avatar">
                        S
                    </div>

                    <div>
                        <strong>Student</strong>
                        <small>Student ID: STU001</small>
                    </div>

                </div>

            </div>

        </header>


        <!-- Statistics -->

        <section class="stats-grid">

            <div class="stat-card">

                <div class="stat-icon attendance-icon">
                    📊
                </div>

                <div>
                    <p>Attendance</p>
                    <h2>87%</h2>
                    <small class="success">
                        ↑ 4% this month
                    </small>
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon syllabus-icon">
                    📚
                </div>

                <div>
                    <p>Syllabus</p>
                    <h2>72%</h2>
                    <small>
                        18 of 25 topics
                    </small>
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon quiz-icon">
                    📝
                </div>

                <div>
                    <p>Quiz Average</p>
                    <h2>84%</h2>
                    <small class="success">
                        Good performance
                    </small>
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon resource-icon">
                    📖
                </div>

                <div>
                    <p>Resources</p>
                    <h2>24</h2>
                    <small>
                        Available materials
                    </small>
                </div>

            </div>

        </section>


        <!-- Dashboard Grid -->

        <section class="dashboard-grid">


            <!-- Attendance -->

            <div class="dashboard-card attendance-card">

                <div class="card-header">

                    <div>
                        <h3>Attendance Overview</h3>
                        <p>Your attendance this semester</p>
                    </div>

                    <a href="/attendance">
                        View Details →
                    </a>

                </div>

                <div class="attendance-content">

                    <div class="circle-progress">

                        <div class="circle-inner">
                            <strong>87%</strong>
                            <span>Attendance</span>
                        </div>

                    </div>

                    <div class="attendance-details">

                        <div>
                            <span class="dot present"></span>
                            Present
                            <strong>42</strong>
                        </div>

                        <div>
                            <span class="dot absent"></span>
                            Absent
                            <strong>5</strong>
                        </div>

                        <div>
                            <span class="dot leave"></span>
                            Leave
                            <strong>3</strong>
                        </div>

                    </div>

                </div>

            </div>


            <!-- Today's Classes -->

            <div class="dashboard-card">

                <div class="card-header">

                    <div>
                        <h3>Today's Classes</h3>
